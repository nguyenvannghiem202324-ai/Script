-- ANTI-HIT LOGIC (kept from original)
--==============================================================

local AntiHitEnabled = false
local IsAntiHitRunning = false
local ANTI_HIT_SPEED = 0.005

local TeleportPoints = {
    Vector3.new(500.62, 241.28, -366.64),
    Vector3.new(504.45, 155.80, -366.35),
    Vector3.new(508.30, 70.28, -366.03),
    Vector3.new(513.86, 70.28, -366.25),
    Vector3.new(519.43, 70.28, -366.47),
    Vector3.new(524.32, 70.28, -366.59),
    Vector3.new(529.22, 70.28, -366.71),
    Vector3.new(538.01, 70.28, -365.55),
    Vector3.new(546.80, 70.28, -364.40)
}

local function TeleportRoute(character)
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    IsAntiHitRunning = true

    for _,position in ipairs(TeleportPoints) do
        if not AntiHitEnabled or not root.Parent then
            IsAntiHitRunning = false
            return
        end
        root.CFrame = CFrame.new(position)
        task.wait(ANTI_HIT_SPEED)
    end

    IsAntiHitRunning = false
end

local function setAntiHitVisual(enabled)
    AntiHitEnabled = enabled

    if enabled then
        antiHitStatus.Text = "ON"
        antiHitStatus.TextColor3 = Color3.fromRGB(105,255,155)
        antiHitTrack.BackgroundColor3 = theme.Accent
        antiHitKnob.BackgroundColor3 = Color3.new(1,1,1)
        tw(antiHitKnob,.22,{Position=UDim2.fromOffset(26,3)},Enum.EasingStyle.Back)
        tw(antiHitIcon,.22,{BackgroundTransparency=.58},Enum.EasingStyle.Quart)
        statusText.Text = "SYSTEM ACTIVE\nAnti-Hit is enabled"
        statusDot.BackgroundColor3 = Color3.fromRGB(75,245,135)
    else
        antiHitStatus.Text = "OFF"
        antiHitStatus.TextColor3 = Color3.fromRGB(255,145,160)
        antiHitTrack.BackgroundColor3 = Color3.fromRGB(55,57,67)
        tw(antiHitKnob,.18,{Position=UDim2.fromOffset(3,3)},Enum.EasingStyle.Quart)
        tw(antiHitIcon,.18,{BackgroundTransparency=.72},Enum.EasingStyle.Quart)
        statusText.Text = "SYSTEM READY\nAnti-Hit is available"
        statusDot.BackgroundColor3 = Color3.fromRGB(75,230,130)
    end
end

antiHitCard.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        click()
        setAntiHitVisual(not AntiHitEnabled)
    end
end)

ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
    if player ~= Player then return end
    if not AntiHitEnabled or IsAntiHitRunning then return end

    local character = Player.Character
    if not character then return end

    task.spawn(function()
        TeleportRoute(character)
    end)
end)

setAntiHitVisual(false)

