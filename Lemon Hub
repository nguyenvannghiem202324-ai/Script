local function tw(obj, time, props, style, direction)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(time or .25, style or Enum.EasingStyle.Quart, direction or Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

