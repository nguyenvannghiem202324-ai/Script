    {progress = 1.00, text = "Đã đăng nhập thành công!"}
}

for _, step in ipairs(steps) do
    Status.Text = step.text
    TweenService:Create(BarFill, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(step.progress, 0, 1, 0)}):Play()
    task.wait(0.5)
end

task.wait(0.3)
FadeOut()

