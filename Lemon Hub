local minimized = false
local transitioning = false
local savedSize = main.Size
local savedPosition = main.Position

local function closeGui()
    if transitioning then return end
    transitioning = true
    if not main.Visible then return end
    savedPosition = main.Position
    savedSize = main.Size
    local outPos = UDim2.new(main.Position.X.Scale,main.Position.X.Offset+28,main.Position.Y.Scale,main.Position.Y.Offset)

    tw(main,.24,{Position=outPos},Enum.EasingStyle.Quart,Enum.EasingDirection.In)
    tw(main,.24,{BackgroundTransparency=1},Enum.EasingStyle.Quart,Enum.EasingDirection.In)
    tw(shadow,.24,{BackgroundTransparency=1},Enum.EasingStyle.Quart,Enum.EasingDirection.In)

    task.delay(.25,function()
        main.Visible=false
        shadow.Visible=false
        dragBar.Visible=false
        resize.Visible=false
        main.BackgroundTransparency=0
        main.Position=savedPosition
        shadow.Position=savedPosition
        shadow.BackgroundTransparency=.45
        showLauncher()
        transitioning = false
    end)
end

local function openGui()
    if transitioning then return end
    transitioning = true
    hideLauncher()
    main.Visible=true
    shadow.Visible=true
    dragBar.Visible=true
    resize.Visible=true
    main.Position=UDim2.new(savedPosition.X.Scale,savedPosition.X.Offset+28,savedPosition.Y.Scale,savedPosition.Y.Offset)
    main.Size=savedSize
    main.BackgroundTransparency=1
    shadow.BackgroundTransparency=1
    tw(main,.30,{Position=savedPosition,BackgroundTransparency=0},Enum.EasingStyle.Back)
    tw(shadow,.30,{Position=savedPosition,BackgroundTransparency=.45},Enum.EasingStyle.Back)
    task.delay(.32,function()
        transitioning = false
    end)
end

close.Activated:Connect(function()
    click()
