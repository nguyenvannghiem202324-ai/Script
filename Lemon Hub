local function updateMobileScale()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local v = camera.ViewportSize
    local scale = math.clamp(math.min(v.X / 430, v.Y / 760), .72, .92)
    rootScale.Scale = scale
end

