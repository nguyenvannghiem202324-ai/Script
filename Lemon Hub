local dragLine = Instance.new("Frame")
dragLine.AnchorPoint = Vector2.new(.5,.5)
dragLine.Position = UDim2.fromScale(.5,.5)
dragLine.Size = UDim2.fromOffset(78,3)
dragLine.BackgroundColor3 = theme.Accent
dragLine.BorderSizePixel = 0
dragLine.ZIndex = 21
dragLine.Parent = dragBar

local dlc = Instance.new("UICorner")
dlc.CornerRadius = UDim.new(1,0)
dlc.Parent = dragLine

local dragging = false
local dragStart
local startPos

local function updateDragBar()
    local p = main.Position
    dragBar.Position = UDim2.new(p.X.Scale,p.X.Offset,p.Y.Scale,p.Y.Offset + main.AbsoluteSize.Y/2 + 12)
end

dragBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        tw(dragLine,.12,{Size=UDim2.fromOffset(108,5)})
    end
end)

UIS.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
    and input.UserInputType ~= Enum.UserInputType.Touch then return end

    local delta = input.Position - dragStart
    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1920,1080)
    local halfW = main.AbsoluteSize.X/2
    local halfH = main.AbsoluteSize.Y/2

    local minX = -viewport.X/2 + halfW + 6
    local maxX = viewport.X/2 - halfW - 6
    local minY = -viewport.Y/2 + halfH + 6
    local maxY = viewport.Y/2 - halfH - 6

    local x = math.clamp(startPos.X.Offset + delta.X,minX,maxX)
    local y = math.clamp(startPos.Y.Offset + delta.Y,minY,maxY)

    main.Position = UDim2.new(.5,x,.49,y)
    shadow.Position = main.Position
    updateDragBar()
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        tw(dragLine,.16,{Size=UDim2.fromOffset(78,3)})
    end
end)

