local pages = {}
local currentPage = "Home"

local function page(name)
    local p = Instance.new("Frame")
    p.Name = name
    p.Size = UDim2.fromScale(1,1)
    p.BackgroundTransparency = 1
    p.Visible = name == "Home"
    p.ZIndex = 6
    p.Parent = content
    pages[name] = p
    return p
end

local homePage = page("Home")
local configPage = page("Config")
local infoPage = page("Info")

local function switchPage(name, button)
    currentPage = name
    for n,p in pairs(pages) do
        p.Visible = n == name
    end

    local targetY = button.Position.Y.Offset + 11
    tw(activeBar,.18,{Position=UDim2.fromOffset(2,targetY)},Enum.EasingStyle.Quart)

    for _,item in ipairs({
        {scriptsTab,scriptsIcon,scriptsName,"Home"},
        {configTab,configIcon,configName,"Config"},
        {infoTab,infoIcon,infoName,"Info"},
    }) do
        local selected = item[4] == name
        item[2].TextColor3 = selected and Color3.new(1,1,1) or Color3.fromRGB(170,175,190)
        item[3].TextColor3 = selected and theme.Accent2 or Color3.fromRGB(130,135,150)
        item[1].BackgroundColor3 = selected and theme.Accent or theme.Card
        item[1].BackgroundTransparency = selected and .08 or .15
    end
end

scriptsTab.Activated:Connect(function() click(); switchPage("Home",scriptsTab) end)
configTab.Activated:Connect(function() click(); switchPage("Config",configTab) end)
infoTab.Activated:Connect(function() click(); switchPage("Info",infoTab) end)

