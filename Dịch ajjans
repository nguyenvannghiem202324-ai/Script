--==================================================
-- SORT KEY
--==================================================

local Keys = {}

for key in pairs(Translation) do
    table.insert(Keys, key)
end

table.sort(Keys, function(a, b)
    return #a > #b
end)

--==================================================
-- HÀM DỊCH
--==================================================

local function TranslateText(text)

    if type(text) ~= "string" or text == "" then
        return text
    end

    local exact = Translation[text]

    if exact then
        return exact
    end

    local result = text

    for _, key in ipairs(Keys) do

        if string.find(result, key, 1, true) then

            result = string.gsub(
                result,
                key,
                Translation[key]
            )

        end

    end

    return result
end

--==================================================
-- CACHE
--==================================================

local Cache = setmetatable({}, {
    __mode = "k"
})

--==================================================
-- DỊCH OBJECT
--==================================================

local function TranslateObject(obj)

    if not obj then
        return
    end

    if not (
        obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox")
    ) then
        return
    end

    local data = Cache[obj]

    if not data then

        data = {
            Text = nil,
            Placeholder = nil
        }

        Cache[obj] = data
    end

    -- TEXT
    pcall(function()

        local current = obj.Text

        if current ~= data.Text then

            local translated =
                TranslateText(current)

            if translated ~= current then
                obj.Text = translated
            end

            data.Text = translated
        end

    end)

    -- PLACEHOLDER
    if obj:IsA("TextBox") then

        pcall(function()

            local current =
                obj.PlaceholderText

            if current ~= data.Placeholder then

                local translated =
                    TranslateText(current)

                if translated ~= current then
                    obj.PlaceholderText = translated
                end

                data.Placeholder = translated
            end

        end)

    end
end

--==================================================
-- QUÉT GUI
--==================================================

local function Scan(container)

    if not container then
        return
    end

    for _, obj in ipairs(
        container:GetDescendants()
    ) do

        TranslateObject(obj)

    end
end

