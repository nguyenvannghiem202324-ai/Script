--==================================================
-- DRAG
--==================================================

local dragging = false
local dragStart
local startPos

Toggle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = Toggle.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

Toggle.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        input.Changed:Connect(function()
            if dragging then
                local delta = input.Position - dragStart

                Toggle.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end)
    end
end)

--==================================================
-- TRANSLATOR
--==================================================

local Enabled = false

local function TranslateObject(Object)
    if not Enabled then
        return
    end

    if Object:IsA("TextLabel")
    or Object:IsA("TextButton")
    or Object:IsA("TextBox") then

        local Text = Object.Text

        if Translation[Text] then
            Object.Text = Translation[Text]
        end

        if Object:IsA("TextBox") then
            local Placeholder = Object.PlaceholderText

            if Translation[Placeholder] then
                Object.PlaceholderText =
                    Translation[Placeholder]
            end
        end
    end
end

local function TranslateAll()
    if not Enabled then
        return
    end

    for _, Object in ipairs(PlayerGui:GetDescendants()) do
        pcall(function()
            TranslateObject(Object)
        end)
    end
end

--==================================================
-- TOGGLE ANIMATION
--==================================================

local function UpdateToggle()
    if Enabled then

        Dot.BackgroundColor3 =
            Color3.fromRGB(90, 255, 130)

        Stroke.Color =
            Color3.fromRGB(90, 255, 130)

        Stroke.Transparency = 0.05

        Title.Text = "VN ✓"

        TweenService:Create(
            Toggle,
            TweenInfo.new(0.18),
            {
                BackgroundColor3 =
                    Color3.fromRGB(28, 38, 31)
            }
        ):Play()

        TranslateAll()

    else

        Dot.BackgroundColor3 =
            Color3.fromRGB(80, 80, 85)

        Stroke.Color =
            Color3.fromRGB(80, 80, 88)

        Stroke.Transparency = 0.35

        Title.Text = "VN"

        TweenService:Create(
            Toggle,
            TweenInfo.new(0.18),
            {
                BackgroundColor3 =
                    Color3.fromRGB(24, 24, 28)
            }
        ):Play()
    end
end

Toggle.Activated:Connect(function()
    Enabled = not Enabled
    UpdateToggle()
end)

--==================================================
-- GUI MỚI XUẤT HIỆN
--==================================================

PlayerGui.DescendantAdded:Connect(function(Object)

    if not Enabled then
        return
    end

    task.defer(function()
        pcall(function()
            TranslateObject(Object)

            for _, Child in ipairs(Object:GetDescendants()) do
                TranslateObject(Child)
            end
        end)
    end)
end)

-- Quét định kỳ để bắt những text được script thay đổi
task.spawn(function()
    while Gui.Parent do
        task.wait(2)

        if Enabled then
            TranslateAll()
        end
    end
end)

