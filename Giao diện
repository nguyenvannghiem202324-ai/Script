--==================================================
--// BUTTON ANIMATION
--==================================================

local function ButtonAnimation(Button, Stroke)

    Button.MouseEnter:Connect(function()

        TweenService:Create(
            Button,
            TweenInfo.new(0.15, Enum.EasingStyle.Quad),
            {
                BackgroundColor3 = Color3.fromRGB(35, 35, 42)
            }
        ):Play()

        TweenService:Create(
            Stroke,
            TweenInfo.new(0.15),
            {
                Color = Color3.fromRGB(170, 170, 180)
            }
        ):Play()
    end)

    Button.MouseLeave:Connect(function()

        TweenService:Create(
            Button,
            TweenInfo.new(0.15, Enum.EasingStyle.Quad),
            {
                BackgroundColor3 = Color3.fromRGB(20, 20, 25)
            }
        ):Play()

        TweenService:Create(
            Stroke,
            TweenInfo.new(0.15),
            {
                Color = Color3.fromRGB(80, 80, 90)
            }
        ):Play()
    end)

    Button.MouseButton1Down:Connect(function()

        TweenService:Create(
            Button,
            TweenInfo.new(0.08),
            {
                Size = UDim2.fromOffset(158, 94)
            }
        ):Play()
    end)

    Button.MouseButton1Up:Connect(function()

        TweenService:Create(
            Button,
            TweenInfo.new(0.08),
            {
                Size = UDim2.fromOffset(165, 100)
            }
        ):Play()
    end)
end

ButtonAnimation(Panel1, Stroke1)
ButtonAnimation(Panel2, Stroke2)

