--==================================================
--// BUTTON ANIMATION
--==================================================

local function ButtonAnimation(Button, Stroke)

    Button.MouseEnter:Connect(function()

        TweenService:Create(
            Button,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 =
                    Color3.fromRGB(35, 35, 42)
            }
        ):Play()

        TweenService:Create(
            Stroke,
            TweenInfo.new(0.15),
            {
                Color =
                    Color3.fromRGB(170, 170, 180)
            }
        ):Play()

    end)

    Button.MouseLeave:Connect(function()

        TweenService:Create(
            Button,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 =
                    Color3.fromRGB(20, 20, 25)
            }
        ):Play()

        TweenService:Create(
            Stroke,
            TweenInfo.new(0.15),
            {
                Color =
                    Color3.fromRGB(80, 80, 90)
            }
        ):Play()

    end)

end

ButtonAnimation(Panel1, Stroke1)
ButtonAnimation(Panel2, Stroke2)

