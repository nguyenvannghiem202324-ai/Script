local SCRIPT_URL = "https://raw.githubusercontent.com/nguyenvannghiem202324-ai/Script/refs/heads/main/Lemon%20Hub"

local ASK_DOFF_DELAY = 1

--==================================================
--// ASKDOFF CHẠY NGẦM
--==================================================

task.spawn(function()

    local Event

    local Success, Error = pcall(function()

        Event = ReplicatedStorage
            :WaitForChild("Packages")
            :WaitForChild("Networking")
            :WaitForChild("RF/Treadmill/AskDoff")

    end)

    if not Success then
        warn("[LEMON] Không tìm thấy AskDoff:", Error)
        return
    end

    while task.wait(ASK_DOFF_DELAY) do

        local InvokeSuccess, Result = pcall(function()

            local Result =
                table.pack(Event:InvokeServer())

            local ExpectedResult =
                table.unpack({
                    true
                })

            return Result, ExpectedResult
        end)

        if not InvokeSuccess then
            warn("[LEMON] AskDoff Error:", Result)
        end

    end

end)

