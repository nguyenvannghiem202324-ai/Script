--========================================================--
-- SORT TRANSLATION KEYS
-- Dài trước để tránh thay nhầm chuỗi
--========================================================--

local Keys = {}

for English, Vietnamese in pairs(T) do
    table.insert(Keys, {
        English,
        Vietnamese
    })
end

table.sort(Keys, function(a, b)
    return #a[1] > #b[1]
end)

--========================================================--
-- TRANSLATE TEXT
--========================================================--

local function TranslateText(Text)

    if type(Text) ~= "string" then
        return Text
    end

    if Text == "" then
        return Text
    end

    -- Exact match
    local Exact = T[Text]

    if Exact then
        return Exact
    end

    -- Partial match
    local Result = Text

    for _, Pair in ipairs(Keys) do

        local English = Pair[1]
        local Vietnamese = Pair[2]

        if string.find(
            Result,
            English,
            1,
            true
        ) then

            Result = string.gsub(
                Result,
                English,
                Vietnamese
            )

        end

    end

    return Result
end

--========================================================--
-- TRANSLATE OBJECT
--========================================================--

local function TranslateObject(Object)

    if not Enabled then
        return
    end

    if not Object:IsA("TextLabel")
        and not Object:IsA("TextButton")
        and not Object:IsA("TextBox") then

        return

    end

    -- Cache kiểm tra
    local OldText = Cache[Object]

    local CurrentText = Object.Text

    if OldText == CurrentText then
        return
    end

    local NewText =
        TranslateText(CurrentText)

    if NewText ~= CurrentText then

        Cache[Object] = NewText

        pcall(function()
            Object.Text = NewText
        end)

    else

        Cache[Object] = CurrentText

    end

    -- Placeholder
    if Object:IsA("TextBox") then

        local Placeholder =
            Object.PlaceholderText

        local NewPlaceholder =
            TranslateText(Placeholder)

        if NewPlaceholder ~= Placeholder then

            pcall(function()
                Object.PlaceholderText =
                    NewPlaceholder
            end)

        end

    end
end

--========================================================--
-- SCAN GUI
--========================================================--

local function ScanContainer(Container)

    if not Container then
        return
    end

    local Objects

    local Success = pcall(function()
        Objects = Container:GetDescendants()
    end)

    if not Success or not Objects then
        return
    end

    for _, Object in ipairs(Objects) do

        if not Enabled then
            break
        end

        TranslateObject(Object)

    end
end

--========================================================--
-- SCAN ALL
--========================================================--

function ScanAll()

    if not Enabled then
        return
    end

    task.spawn(function()

        ScanContainer(PlayerGui)

    end)

    task.spawn(function()

        pcall(function()
            ScanContainer(CoreGui)
        end)

    end)

end

--========================================================--
-- NEW GUI DETECTOR
-- Không quét liên tục
--========================================================--

local function ConnectContainer(Container)

    if not Container then
        return
    end

    Container.DescendantAdded:Connect(function(Object)

        if not Enabled then
            return
        end

        task.defer(function()

            TranslateObject(Object)

        end)

    end)

end

ConnectContainer(PlayerGui)

pcall(function()
    ConnectContainer(CoreGui)
end)

--========================================================--
-- INITIAL TRANSLATION
--========================================================--

task.spawn(function()

    task.wait(0.3)

    ScanAll()

end)

-- Quét lại một lần sau khi menu load hoàn toàn
task.delay(2, function()

    if Enabled then
        ScanAll()
    end

end)

