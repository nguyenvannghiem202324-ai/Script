--========================================================--
-- UPDATE TOGGLE
--========================================================--

local function UpdateToggle()

    local Info =
        TweenInfo.new(
            0.18,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out
        )

    local TargetColor
    local TargetPosition

    if Enabled then

        TargetColor =
            ON_COLOR

        TargetPosition =
            UDim2.new(
                1,
                -23,
                0.5,
                0
            )

    else

        TargetColor =
            OFF_COLOR

        TargetPosition =
            UDim2.new(
                0,
                3,
                0.5,
                0
            )

    end

    TweenService:Create(
        Background,
        Info,
        {
            BackgroundColor3 =
                TargetColor
        }
    ):Play()

    TweenService:Create(
        Knob,
        Info,
        {
            Position =
                TargetPosition
        }
    ):Play()

end

--========================================================--
-- DRAG
--========================================================--

local Dragging =
    false

local DragStart =
    nil

local StartPosition =
    nil

local DragMoved =
    false

Toggle.InputBegan:Connect(function(Input)

    if Input.UserInputType ==
        Enum.UserInputType.MouseButton1

        or

        Input.UserInputType ==
        Enum.UserInputType.Touch then

        Dragging =
            true

        DragMoved =
            false

        DragStart =
            Input.Position

        StartPosition =
            Toggle.Position

    end

end)

UserInputService.InputChanged:Connect(function(Input)

    if not Dragging then
        return
    end

    if Input.UserInputType ==
        Enum.UserInputType.MouseMovement

        or

        Input.UserInputType ==
        Enum.UserInputType.Touch then

        local Delta =
            Input.Position -
            DragStart

        if math.abs(Delta.X) > 4
            or math.abs(Delta.Y) > 4 then

            DragMoved =
                true

        end

        Toggle.Position =
            UDim2.new(
                StartPosition.X.Scale,
                StartPosition.X.Offset +
                    Delta.X,

                StartPosition.Y.Scale,
                StartPosition.Y.Offset +
                    Delta.Y
            )

    end

end)

--========================================================--
-- CLICK / RELEASE
--========================================================--

UserInputService.InputEnded:Connect(function(Input)

    if Input.UserInputType ==
        Enum.UserInputType.MouseButton1

        or

        Input.UserInputType ==
        Enum.UserInputType.Touch then

        if Dragging
            and not DragMoved then

            Enabled =
                not Enabled

            if Enabled then

                Cache =
                    setmetatable(
                        {},
                        {
                            __mode = "k"
                        }
                    )

                task.spawn(
                    ScanAll
                )

            end

            UpdateToggle()

        end

        Dragging =
            false

    end

end)

