local function setSpeedFromFraction(fraction)
    fraction = math.clamp(fraction, 0, 1)
    BYPASS_SPEED = math.clamp(
        math.floor(MIN_SPEED + fraction * (MAX_SPEED - MIN_SPEED) + 0.5),
        MIN_SPEED,
        MAX_SPEED
    )
    local fill = speedFraction()
    sliderFill.Size = UDim2.new(fill, 0, 1, 0)
    sliderKnob.Position = UDim2.new(fill, 0, 0.5, 0)
    speedLabel.Text = "BYPASS SPEED: " .. BYPASS_SPEED
    applySpeedToCurrentHumanoid()
end

local function updateSlider(input)
    local width = sliderBar.AbsoluteSize.X
    if width <= 0 then return end
    local fraction = (input.Position.X - sliderBar.AbsolutePosition.X) / width
    setSpeedFromFraction(fraction)
end

local sliderDragging = false
sliderBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
        updateSlider(input)
    end
end)

table.insert(UIConnections, UserInputService.InputChanged:Connect(function(input)
    if sliderDragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
