local menuOpen = true
local launcherBusy = false
local launcherDragging = false
local launcherMoved = false
local launcherDragStart, launcherStartPos

launcher.Activated:Connect(function()
    if launcherMoved then launcherMoved = false return end
    if launcherBusy then return end
    launcherBusy = true
    menuOpen = not menuOpen
    if menuOpen then
        main.Visible = true
        main.BackgroundTransparency = 1
        TweenService:Create(main, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            BackgroundTransparency = 1,
            Position = UDim2.new(0.5, -290, 0.32, 0)
        }):Play()
        launcherSub.Text = "MENU • OPEN"
        launcherArrow.Text = "‹"
    else
        main.Visible = false
        launcherSub.Text = "MENU • CLOSED"
        launcherArrow.Text = "›"
    end
    TweenService:Create(launcher, TweenInfo.new(0.12), {Size = UDim2.fromOffset(151, 39)}):Play()
    task.delay(0.14, function()
        if launcher.Parent then
            TweenService:Create(launcher, TweenInfo.new(0.16), {Size = UDim2.fromOffset(158, 42)}):Play()
        end
    end)
    task.delay(0.25, function() launcherBusy = false end)
end)

launcher.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        launcherDragging = true
        launcherMoved = false
        launcherDragStart = input.Position
        launcherStartPos = launcher.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if launcherDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - launcherDragStart
        if math.abs(delta.X) + math.abs(delta.Y) > 8 then launcherMoved = true end
        if launcherMoved then
            local p = UDim2.new(launcherStartPos.X.Scale, launcherStartPos.X.Offset + delta.X,
                launcherStartPos.Y.Scale, launcherStartPos.Y.Offset + delta.Y)
            launcher.Position = p
            launcherGlow.Position = UDim2.new(p.X.Scale, p.X.Offset - 3, p.Y.Scale, p.Y.Offset - 3)
        end
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        launcherDragging = false
    end
end)

