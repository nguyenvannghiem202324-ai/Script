local function createToggle(text, y, initial, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -24, 0, 44)
    button.Position = UDim2.fromOffset(12, y)
    button.BackgroundColor3 = initial
        and Color3.fromRGB(54, 190, 105)
        or Color3.fromRGB(65, 65, 72)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 14
    button.Text = text .. (initial and "  [ON]" or "  [OFF]")
    button.Parent = main
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 9)

    local state = initial

    button.Activated:Connect(function()
        state = not state
        button.Text = text .. (state and "  [ON]" or "  [OFF]")
        button.BackgroundColor3 = state
            and Color3.fromRGB(54, 190, 105)
            or Color3.fromRGB(65, 65, 72)

        callback(state)
    end)

    return button
end

createToggle("Anti Boss Fling", 55, true, function(state)
    EnabledFling = state
end)

createToggle("Xóa tường Zone1–9", 108, false, function(state)
    EnabledWalls = state

    if not state then
        return
    end

    local build = Workspace:FindFirstChild("Build")
    local zones = build and build:FindFirstChild("ZoneBuilds")

    if not zones then
        warn("Không tìm thấy Workspace.Build.ZoneBuilds")
        EnabledWalls = false
        return
    end

    local count = 0

    for zoneNumber = 1, 9 do
        local zone = zones:FindFirstChild("Zone" .. zoneNumber)

        if zone then
            for _, obj in ipairs(zone:GetDescendants()) do
                if EnabledWalls
                    and obj:IsA("BasePart")
                    and obj.Name == "Part" then

                    local size = obj.Size
                    local pos = obj.Position

                    if size.X >= 80
                        and size.Y >= 20
                        and size.Z >= 50
                        and math.abs(pos.Z - 120.25) <= 10 then

                        pcall(function()
                            obj:Destroy()
                        end)
                        count += 1
                    end
                end
            end
        end
    end

    DeletedWalls += count
    print("Đã xóa " .. count .. " Part giống tường ở client.")
end)

