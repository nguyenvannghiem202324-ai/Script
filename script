-- Hàm tạo nút Toggle phong cách Gaming Panel
local function createToggle(text, y, initial, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(250, 42)
    button.Position = UDim2.fromOffset(14, y)
    button.ZIndex = 4
    button.BackgroundColor3 = initial
        and Color3.fromRGB(220, 70, 35) -- Đỏ lửa khi ON
        or Color3.fromRGB(35, 32, 42)   -- Tối khi OFF
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 13
    button.Text = text .. (initial and "  [ON]" or "  [OFF]")
    button.Parent = main
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = initial and Color3.fromRGB(255, 180, 50) or Color3.fromRGB(60, 55, 70)
    btnStroke.Thickness = 1
    btnStroke.Parent = button

    local state = initial

    button.Activated:Connect(function()
        state = not state
        button.Text = text .. (state and "  [ON]" or "  [OFF]")
        button.BackgroundColor3 = state
            and Color3.fromRGB(220, 70, 35)
            or Color3.fromRGB(35, 32, 42)
        btnStroke.Color = state and Color3.fromRGB(255, 180, 50) or Color3.fromRGB(60, 55, 70)

        callback(state)
    end)

    return button
end

createToggle("Anti Boss Fling", 60, true, function(state)
    EnabledFling = state
end)

createToggle("Xóa tường Zone1–9", 112, false, function(state)
    EnabledWalls = state

    if not state then
        return
    end

    local build = Workspace:FindFirstChild("Build")
    local zones = build and build:FindFirstChild("ZoneBuilds")

    if not zones then
        warn("Không tìm thấy Workspace.Build.ZoneBuilds")
        EnabledWalls = false
        return
    end

    local count = 0

    for zoneNumber = 1, 9 do
        local zone = zones:FindFirstChild("Zone" .. zoneNumber)

        if zone then
            for _, obj in ipairs(zone:GetDescendants()) do
                if EnabledWalls
                    and obj:IsA("BasePart")
                    and obj.Name == "Part" then

                    local size = obj.Size
                    local pos = obj.Position

                    if size.X >= 80
                        and size.Y >= 20
                        and size.Z >= 50
                        and math.abs(pos.Z - 120.25) <= 10 then

                        pcall(function()
                            obj:Destroy()
                        end)
                        count += 1
                    end
                end
            end
        end
    end

    DeletedWalls += count
    print("Đã xóa " .. count .. " Part giống tường ở client.")
end)

