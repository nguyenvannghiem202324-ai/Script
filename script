local function stopSpeedAnimation()
    if currentAnimationTrack then
        pcall(function()
            currentAnimationTrack:Stop()
            currentAnimationTrack:Destroy()
        end)
        currentAnimationTrack = nil
    end
end

local function bypassSpeed()
    local character = Player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end

    BypassEnabled = not BypassEnabled
    if BypassEnabled then
        humanoid.WalkSpeed = BYPASS_SPEED
        bypassButton.Text = "BYPASS SPEED [ON]"
        bypassButton.BackgroundColor3 = Color3.fromRGB(220, 70, 35)
        bypassButton.TextColor3 = Color3.new(1, 1, 1)

        stopSpeedAnimation()
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = humanoid
        end

        local animation = Instance.new("Animation")
        animation.AnimationId = ANIMATION_ID
        local ok, track = pcall(function()
            return animator:LoadAnimation(animation)
        end)
        if ok and track then
            currentAnimationTrack = track
            track.Priority = Enum.AnimationPriority.Action
            track.Looped = true
            if humanoid:GetState() ~= Enum.HumanoidStateType.Ragdoll
                and humanoid:GetState() ~= Enum.HumanoidStateType.Physics
                and humanoid:GetState() ~= Enum.HumanoidStateType.FallingDown then
                track:Play()
            end
        end

        table.insert(Connections, humanoid.StateChanged:Connect(function(_, newState)
            if newState == Enum.HumanoidStateType.Ragdoll
                or newState == Enum.HumanoidStateType.Physics
                or newState == Enum.HumanoidStateType.FallingDown then
                stopSpeedAnimation()
            elseif BypassEnabled and currentAnimationTrack == nil then
                local currentAnimator = humanoid:FindFirstChildOfClass("Animator")
                if currentAnimator then
                    local anim = Instance.new("Animation")
                    anim.AnimationId = ANIMATION_ID
                    local success, newTrack = pcall(function()
                        return currentAnimator:LoadAnimation(anim)
                    end)
                    if success and newTrack then
                        currentAnimationTrack = newTrack
                        newTrack.Priority = Enum.AnimationPriority.Action
                        newTrack.Looped = true
                        newTrack:Play()
                    end
                end
            end
        end))

        pcall(function()
            humanoid:ChangeState(Enum.HumanoidStateType.Ragdoll)
        end)
        task.delay(0.65, function()
            if BypassEnabled and Player.Character == character
                and humanoid.Parent and humanoid.Health > 0 then
                pcall(function()
                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                end)
                task.delay(0.15, function()
                    if BypassEnabled and Player.Character == character
                        and humanoid.Parent and humanoid.Health > 0 then
                        pcall(function()
                            humanoid:ChangeState(Enum.HumanoidStateType.Running)
                        end)
                        humanoid.WalkSpeed = BYPASS_SPEED
                    end
                end)
            end
        end)
    else
        stopSpeedAnimation()
        bypassButton.Text = "BYPASS SPEED [OFF]"
        bypassButton.BackgroundColor3 = Color3.fromRGB(45, 35, 30)
        bypassButton.TextColor3 = Color3.fromRGB(255, 180, 50)
        humanoid.WalkSpeed = 16
    end
end

