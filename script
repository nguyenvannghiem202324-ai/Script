tween(logoScale, 0.8, {Scale = 1}, Enum.EasingStyle.Back)

-- Đợi logo xuất hiện 3 giây rồi thử phát audio.
-- Chờ tải tối đa 5 giây để tránh treo intro nếu ID không tải được.
task.delay(3, function()
    if not gui.Parent or not introSound.Parent then return end

    local deadline = os.clock() + 5
    while not introSound.IsLoaded and os.clock() < deadline and gui.Parent do
        task.wait(0.1)
    end

    if gui.Parent and introSound.IsLoaded then
        pcall(function()
            SoundService:PlayLocalSound(introSound)
        end)
    else
        warn("[NHAT Intro] Audio chưa tải được. Kiểm tra ID, quyền truy cập và âm lượng Roblox.")
    end
end)

-- Each letter rises from below the screen to a row under the logo.
-- Start times relative to the 3-second point: N=0s, H=1.2s, Ậ=2.5s, T=3.9s.
local letterStartTime = 3
local delays = {
    letterStartTime,
    letterStartTime + 1.2,
    letterStartTime + 1.2 + 1.3,
    letterStartTime + 1.2 + 1.3 + 1.4
}
for i, label in ipairs(labels) do
    task.delay(delays[i], function()
        if not gui.Parent or not label.Parent then return end

        tween(label, 0.62, {
            Position = UDim2.new(0.5, xOffsets[i], 0.565, 0),
            TextTransparency = 0,
            TextStrokeTransparency = 0.35
        }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

        local scale = label:FindFirstChildOfClass("UIScale")
        if scale then
            tween(scale, 0.62, {Scale = 1}, Enum.EasingStyle.Back)
        end
    end)
end

-- 1.3 seconds after T's start, briefly highlight the complete word.
task.delay(letterStartTime + 1.2 + 1.3 + 1.4 + 1.3, function()
    if not gui.Parent then return end

    for _, label in ipairs(labels) do
        if label.Parent then
            tween(label, 0.22, {
                TextColor3 = Color3.fromRGB(255, 157, 72),
                TextStrokeTransparency = 0.05
            }, Enum.EasingStyle.Quad)
        end
    end

    task.wait(0.65)
    if not gui.Parent then return end

    tween(background, 0.55, {BackgroundTransparency = 1}, Enum.EasingStyle.Quad)
    tween(logo, 0.55, {ImageTransparency = 1}, Enum.EasingStyle.Quad)
    for _, label in ipairs(labels) do
        if label.Parent then
            tween(label, 0.45, {
                TextTransparency = 1,
                TextStrokeTransparency = 1
            }, Enum.EasingStyle.Quad)
        end
    end

    task.wait(0.6)
    if gui.Parent then gui:Destroy() end
end)


