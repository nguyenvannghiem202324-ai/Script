-- Hàm kiểm tra Blacklist
local function isURLBlacklisted(urlToCheck)
    if type(urlToCheck) ~= "string" then return false end
    for _, blacklistedURL in ipairs(blacklistedScriptURLs) do
        if string.find(urlToCheck, blacklistedURL, 1, true) then
            return true
        end
    end
    return false
end

-- Hàm kiểm tra Whitelist
local function isURLAllowed(urlToCheck)
    if type(urlToCheck) ~= "string" then return false end
    for _, allowedURL in ipairs(allowedScriptURLs) do
        if string.find(urlToCheck, allowedURL, 1, true) then
            return true 
        end
    end
    return false 
end

-- Sử dụng hookmetamethod để chặn namecall (Cách này chặn game:HttpGet cực mạnh)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    -- Chỉ kiểm tra khi đối tượng gọi là 'game' và phương thức là HttpGet/HttpGetAsync
    if self == game and (method == "HttpGet" or method == "HttpGetAsync") then
        local url = args[1]
        
        if type(url) == "string" then
            -- 1. Ưu tiên check Blacklist
            if isURLBlacklisted(url) then
                LocalPlayer:Kick("Bảo mật: Phát hiện gian lận sử dụng FlyGuiV3! Cấm sử dụng script này.")
                return ""
            end
            
            -- 2. Check Whitelist
            if not isURLAllowed(url) then
                LocalPlayer:Kick("Bảo mật: Phát hiện chạy script lạ! Vui lòng không dùng chung với script khác.")
                return "" 
            end
        end
    end
    
    -- Trả về phương thức gốc nếu hợp lệ
    return oldNamecall(self, ...)
end)

