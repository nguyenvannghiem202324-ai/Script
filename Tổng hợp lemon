--//======================================================
--// TAB SYSTEM
--//======================================================

local CurrentTab = nil

local function SetTab(Name)

    if CurrentTab == Name then
        return
    end

    CurrentTab = Name

    for TabName, TabData in pairs(Tabs) do

        local Active = TabName == Name

        Tween(TabData.Button, 0.2, {

            BackgroundColor3 =
                Active
                and Color3.fromRGB(45, 24, 67)
                or Color3.fromRGB(24, 17, 37),

            TextColor3 =
                Active
                and C.WHITE
                or C.GRAY

        })

        Tween(TabData.Accent, 0.2, {

            BackgroundTransparency =
                Active and 0 or 1

        })

    end

    for PageName, Page in pairs(Pages) do

        if PageName == Name then

            Page.Visible = true

            Page.Position = UDim2.new(
                0,
                10,
                0,
                0
            )

            Tween(Page, 0.22, {

                Position = UDim2.new(
                    0,
                    0,
                    0,
                    0
                )

            })

        else

            Page.Visible = false

        end

    end
end

