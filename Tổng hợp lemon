local function CreateLogo(Parent, Size, Position, ZIndex)

    local MainZ = ZIndex or 10

    --// Glow
    local Glow = New("ImageLabel", {
        Name = "LogoGlow",

        BackgroundTransparency = 1,

        Image = LOGO,

        ImageColor3 = C.PURPLE2,

        ImageTransparency = 0.72,

        Size = UDim2.new(
            Size.X.Scale,
            Size.X.Offset + 10,
            Size.Y.Scale,
            Size.Y.Offset + 10
        ),

        Position = UDim2.new(
            Position.X.Scale,
            Position.X.Offset - 5,
            Position.Y.Scale,
            Position.Y.Offset - 5
        ),

        ScaleType = Enum.ScaleType.Fit,

        ZIndex = MainZ - 1
    }, Parent)

    --// Logo chính
    local Image = New("ImageLabel", {

        Name = "Logo",

        BackgroundTransparency = 1,

        Image = LOGO,

        ImageTransparency = 0,

        Size = Size,

        Position = Position,

        ScaleType = Enum.ScaleType.Fit,

        ZIndex = MainZ

    }, Parent)

    --// Logo pulse
    task.spawn(function()

        while Image.Parent and ScreenGui.Parent do

            Tween(Glow, 1.2, {
                ImageTransparency = 0.56
            })

            task.wait(1.2)

            if not Glow.Parent then
                break
            end

            Tween(Glow, 1.2, {
                ImageTransparency = 0.78
            })

            task.wait(1.2)
        end

    end)

    return Image
end

--//======================================================
--// LOADSTRING HELPER
--//======================================================

local function ExecuteURL(URL)

    if type(loadstring) ~= "function" then
        error("loadstring is not available")
    end

    local Source = game:HttpGet(URL)

    if not Source or Source == "" then
        error("Không lấy được script")
    end

    local Function, CompileError = loadstring(Source)

    if not Function then
        error(CompileError or "Không compile được script")
    end

    return Function()
end

