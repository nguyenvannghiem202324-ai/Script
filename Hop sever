    end
end

-- LOGIC HOP SERVER 1 PLAYER THỦ CÔNG (CLICK NÚT 1)
local function manualHop1Player()
    if Teleporting then return end
    Teleporting = true
    updateUI()
    Hop1Btn.Text = "⏳ ĐANG QUÉT 1 PLAYER..."

    task.spawn(function()
        local cursor = ""
        local candidates = {}

        for page = 1, 12 do
            local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then url = url .. "&cursor=" .. HttpService:UrlEncode(cursor) end

            local ok, result = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
            if ok and result and result.data then
                for _, s in ipairs(result.data) do
                    if s.id and s.id ~= CurrentJobId and tonumber(s.playing) == 1 and tonumber(s.maxPlayers) > 1 then
                        if not table.find(getgenv().VisitedServers, s.id) then
                            table.insert(candidates, s.id)
                        end
                    end
                end
            end

            cursor = result and result.nextPageCursor or ""
            if #candidates > 0 or cursor == "" then break end
            task.wait(0.1)
        end

        if #candidates > 0 then
            local chosen = candidates[math.random(1, #candidates)]
            table.insert(getgenv().VisitedServers, chosen)
            pcall(function() TeleportService:TeleportToPlaceInstance(PlaceId, chosen, LocalPlayer) end)
            task.wait(8)
            if game.JobId == CurrentJobId then Teleporting = false end
        else
            warn("[AutoHop] Không thấy server 1 người. Đang làm sạch bộ nhớ...")
            getgenv().VisitedServers = {CurrentJobId}
            Teleporting = false
        end

        Hop1Btn.Text = "⚡ HOP SERVER 1 PLAYER"
        updateUI()
    end)
end

-- LOGIC CỦA AUTO HOP KHI QUÁ GIỚI HẠN
local function doAutoHop()
    if Teleporting then return end
    Teleporting = true
    updateUI()

    task.spawn(function()
        local cursor = ""
        local servers = {}
        for page = 1, 10 do
            local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then url = url .. "&cursor=" .. HttpService:UrlEncode(cursor) end

            local ok, result = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
            if ok and result and result.data then
                for _, s in ipairs(result.data) do
                    if s.id and s.id ~= CurrentJobId and tonumber(s.playing) and tonumber(s.playing) <= 2 and tonumber(s.maxPlayers) > 1 then
                        if not table.find(getgenv().VisitedServers, s.id) then
                            table.insert(servers, s.id)
                        end
                    end
                end
            end

            cursor = result and result.nextPageCursor or ""
            if #servers > 0 or cursor == "" then break end
            task.wait(0.1)
        end

        if #servers > 0 then
            local chosen = servers[math.random(1, #servers)]
            table.insert(getgenv().VisitedServers, chosen)
            pcall(function() TeleportService:TeleportToPlaceInstance(PlaceId, chosen, LocalPlayer) end)
            task.wait(8)
            if game.JobId == CurrentJobId then Teleporting = false end
        else
            getgenv().VisitedServers = {CurrentJobId}
            Teleporting = false
        end
        updateUI()
    end)
end

-- VÒNG LẶP THEO DÕI REAL-TIME
task.spawn(function()
    while task.wait(1) do
        if not GUI.Parent then break end

        local pCount = #Players:GetPlayers()
        PlayerCountLabel.Text = "👤 Đang có: " .. pCount .. " người"
        
        if pCount > HopLimit then
            PlayerCountLabel.TextColor3 = Color3.fromRGB(255, 80, 80) -- Màu đỏ báo động
        else
            PlayerCountLabel.TextColor3 = Color3.fromRGB(150, 255, 150) -- Màu xanh an toàn
        end

        -- Tự nhảy nếu Bật Auto Hop và số người quá giới hạn
        if Enabled and not Teleporting and pCount > HopLimit then
            doAutoHop()
        end
    end
end)

