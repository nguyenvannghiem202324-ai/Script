    else
        ModeBtn.Text = "CHẾ ĐỘ: HOP KHI CÓ 3 NGƯỜI"
    end
end

-- LOGIC TÌM SERVER (Tìm server <= 2 người để nhảy vào)
local function getServers()
    local servers = {}
    local cursor = nil
    for page = 1, 10 do
        if not Teleporting then break end

        local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor and cursor ~= "" then url = url .. "&cursor=" .. HttpService:UrlEncode(cursor) end

        local ok, result = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
        if not ok or not result or not result.data then break end

        for _, s in ipairs(result.data) do
            if s.id and s.id ~= CurrentJobId and tonumber(s.playing) and tonumber(s.playing) <= 2 and tonumber(s.maxPlayers) > 1 then
                if not table.find(getgenv().VisitedServers, s.id) then
                    table.insert(servers, s.id)
                end
            end
        end

        cursor = result.nextPageCursor
        if #servers > 0 or not cursor or cursor == "" then break end
        task.wait(0.1)
    end
    return servers
end

-- LOGIC THỰC THI HOP
local function doHop()
    if Teleporting then return end
    Teleporting = true
    updateUI()

    task.spawn(function()
        local servers = getServers()
        if #servers > 0 then
            local chosen = servers[math.random(1, #servers)]
            table.insert(getgenv().VisitedServers, chosen)
            
            pcall(function() TeleportService:TeleportToPlaceInstance(PlaceId, chosen, LocalPlayer) end)
            
            task.wait(10)
            if game.JobId == CurrentJobId then Teleporting = false end -- Teleport fail
        else
            warn("[AutoHop] Không thấy server vắng. Đang Reset bộ nhớ...")
            getgenv().VisitedServers = {CurrentJobId}
            Teleporting = false
        end
        updateUI()
    end)
end

-- VÒNG LẶP THEO DÕI REAL-TIME
task.spawn(function()
    while task.wait(1) do
        if not GUI.Parent then break end

        -- Cập nhật label số người chơi
        local pCount = #Players:GetPlayers()
        PlayerCountLabel.Text = "👤 Đang có: " .. pCount .. " người"
        if pCount > HopLimit then
            PlayerCountLabel.TextColor3 = Color3.fromRGB(255, 80, 80) -- Đỏ báo động
        else
            PlayerCountLabel.TextColor3 = Color3.fromRGB(150, 255, 150) -- Xanh an toàn
        end

        -- Kích hoạt Hop nếu Đang Bật + Đạt điều kiện + Chưa Teleport
        if Enabled and not Teleporting and pCount > HopLimit then
            doHop()
        end
    end
end)

