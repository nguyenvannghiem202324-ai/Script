-- NhatHub | Auto Hop 1 Player (Mobile: Delta X / Fluxus)
local SCRIPT_URL = "https://raw.githubusercontent.com/USERNAME/REPO/main/NhatHub_AutoHop.lua" -- << ĐỔI LINK Ở ĐÂY

local STATE_FILE   = "NhatHub_HopState.txt"
local VISITED_FILE = "NhatHub_Visited.json"
local LOADER_FILE  = "NhatHub_AutoHop.lua"
local MAX_PAGES    = 15

if not game:IsLoaded() then game.Loaded:Wait() end

local env = (getgenv and getgenv()) or _G
if env.NhatHubLoaded == game.JobId then return end -- chỉ chặn chạy trùng TRONG CÙNG server
env.NhatHubLoaded = game.JobId

-- Dọn UI cũ nếu có (tránh trùng nút khi script chạy lại)
pcall(function()
    local parent = (gethui and gethui()) or game:GetService("CoreGui")
    local old = parent:FindFirstChild("NhatHubAutoHop")
    if old then old:Destroy() end
end)

local Players         = game:GetService("Players")
local HttpService     = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local UIS             = game:GetService("UserInputService")
local LocalPlayer     = Players.LocalPlayer
while not LocalPlayer do task.wait() LocalPlayer = Players.LocalPlayer end

---------------------------------------------------------------------
-- 1. AUTO-LOADER ẨN (ghi file autoexec dự phòng)
---------------------------------------------------------------------
local loaderCode = ('loadstring(game:HttpGet("%s"))()'):format(SCRIPT_URL)
local function installLoader()
    if not writefile then return end
    local paths = { LOADER_FILE, "autoexec/" .. LOADER_FILE, "autoexecute/" .. LOADER_FILE }
    for _, p in ipairs(paths) do
        pcall(function()
            if makefolder then
                local folder = p:match("^(.-)/")
                if folder and isfolder and not isfolder(folder) then makefolder(folder) end
            end
            if not (isfile and isfile(p)) then writefile(p, loaderCode) end
        end)
    end
end
installLoader()

---------------------------------------------------------------------
-- 2. RECURSIVE QUEUE (retry 3 lần, cách nhau 2s)
---------------------------------------------------------------------
local queueFn = queue_on_teleport
    or (syn and syn.queue_on_teleport)
    or (fluxus and fluxus.queue_on_teleport)

local queuedCode = ([[
task.wait(1)
for i = 1, 3 do
    local ok = pcall(function() loadstring(game:HttpGet("%s"))() end)
    if ok then break end
    task.wait(2)
end
]]):format(SCRIPT_URL)

local function queueNext()
    if queueFn then pcall(queueFn, queuedCode) end
end

-- Lớp dự phòng 1: queue ngay khi script khởi động ở mỗi server
queueNext()
-- Lớp dự phòng 2: queue lại đúng lúc teleport bắt đầu (kể cả khi game tự teleport/kick)
pcall(function()
    LocalPlayer.OnTeleport:Connect(function(state)
        if state == Enum.TeleportState.Started or state == Enum.TeleportState.RequestedFromServer then
            queueNext()
        end
    end)
end)

---------------------------------------------------------------------
-- 3. STATE PERSISTENCE
---------------------------------------------------------------------
local function readState()
    if readfile and isfile and isfile(STATE_FILE) then
        local ok, v = pcall(readfile, STATE_FILE)
        if ok and v then return v:gsub("%s", "") == "true" end
    end
    return false
end
local function saveState(v)
    if writefile then pcall(writefile, STATE_FILE, tostring(v)) end
end

---------------------------------------------------------------------
-- VISITED SERVERS
---------------------------------------------------------------------
env.VisitedServers = env.VisitedServers or {}
if next(env.VisitedServers) == nil and readfile and isfile and isfile(VISITED_FILE) then
    pcall(function()
        for _, id in ipairs(HttpService:JSONDecode(readfile(VISITED_FILE))) do
            env.VisitedServers[id] = true
        end
    end)
end
local function saveVisited()
    if not writefile then return end
    local list = {}
    for id in pairs(env.VisitedServers) do list[#list + 1] = id end
    pcall(writefile, VISITED_FILE, HttpService:JSONEncode(list))
end
env.VisitedServers[game.JobId] = true
saveVisited()

---------------------------------------------------------------------
-- LOGIC TÌM SERVER 1 PLAYER
---------------------------------------------------------------------
local enabled, teleporting = false, false
local setUI -- khai báo trước

local function findServer()
    local cursor = ""
    for _ = 1, MAX_PAGES do
        if not enabled then return nil end
        local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s")
            :format(game.PlaceId, cursor ~= "" and ("&cursor=" .. cursor) or "")
        local ok, data = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        if not ok or type(data) ~= "table" or not data.data then
            task.wait(3) -- rate limit / lỗi mạng
            return nil, true
        end
        for _, s in ipairs(data.data) do
            if s.playing == 1 and s.maxPlayers > 1
                and s.id ~= game.JobId and not env.VisitedServers[s.id] then
                return s.id
            end
        end
        cursor = data.nextPageCursor
        if not cursor then break end
        task.wait(0.5)
    end
    return nil
end

TeleportService.TeleportInitFailed:Connect(function()
    teleporting = false -- vòng lặp sẽ tự chọn server khác
end)

local loopToken = 0
local function startHop()
    loopToken += 1
    local myToken = loopToken
    task.spawn(function()
        while enabled and myToken == loopToken do
            if not teleporting then
                local id, netErr = findServer()
                if id then
                    env.VisitedServers[id] = true
                    saveVisited()
                    teleporting = true
                    queueNext()
                    pcall(function()
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, id, LocalPlayer)
                    end)
                    local t = 0
                    while teleporting and t < 10 and enabled do task.wait(1) t += 1 end
                    teleporting = false
                elseif not netErr then
                    env.VisitedServers = { [game.JobId] = true } -- reset rồi thử lại
                    saveVisited()
                    task.wait(2)
                end
            else
                task.wait(1)
            end
        end
    end)
end

---------------------------------------------------------------------
-- UI: 1 nút, kéo thả được
---------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "NhatHubAutoHop"
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
local okParent = pcall(function() gui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
if not okParent or not gui.Parent then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

local btn = Instance.new("TextButton")
btn.Size = UDim2.fromOffset(110, 38)
btn.Position = UDim2.new(0, 20, 0.35, 0)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 14
btn.TextColor3 = Color3.new(1, 1, 1)
btn.AutoButtonColor = false
btn.Parent = gui
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

setUI = function()
    btn.Text = enabled and "HOP: ON" or "HOP: OFF"
    btn.BackgroundColor3 = enabled and Color3.fromRGB(46, 170, 90) or Color3.fromRGB(200, 60, 60)
end

local function setEnabled(v)
    enabled = v
    saveState(v)
    setUI()
    if v then startHop() else loopToken += 1 teleporting = false end
end

-- Kéo thả + phân biệt chạm/kéo
local dragging, dragStart, startPos, moved = false, nil, nil, false
btn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging, moved = true, false
        dragStart, startPos = input.Position, btn.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local d = input.Position - dragStart
        if d.Magnitude > 8 then moved = true end
        if moved then
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end
end)
UIS.InputEnded:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then
        dragging = false
        if not moved then setEnabled(not enabled) end
    end
end)

---------------------------------------------------------------------
-- KHỞI ĐỘNG: đọc state, tự hop tiếp nếu đang bật
---------------------------------------------------------------------
enabled = readState()
setUI()
if enabled then
    task.wait(3) -- chờ server mới ổn định
    startHop()
end
