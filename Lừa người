--// Kéo bảng
local dragging = false
local dragStart
local startPos

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = frame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then

        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

--// =========================================
--// 0 -> 100% TRONG 120 GIÂY
--// =========================================

local totalTime = 120
local startTime = tick()

while true do
    local elapsed = tick() - startTime
    local progress = math.clamp(elapsed / totalTime, 0, 1)

    bar.Size = UDim2.new(progress, 0, 1, 0)

    local value = math.floor(progress * 100)
    percent.Text = value .. "%"

    if value < 25 then
        status.Text = "Đang tải dữ liệu..."
    elseif value < 50 then
        status.Text = "Đang kiểm tra..."
    elseif value < 75 then
        status.Text = "Đang khởi tạo..."
    elseif value < 100 then
        status.Text = "Sắp hoàn tất..."
    else
        status.Text = "Hoàn tất!"
    end

    if progress >= 1 then
        break
    end

    task.wait(0.05)
end

