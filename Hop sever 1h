local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- CẤU HÌNH THỜI GIAN: 1 giờ 30 phút = 5400 giây
local timeLeft = 5400 

-- TẠO GIAO DIỆN
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AutoHopPro"
ScreenGui.Parent = game:GetService("CoreGui")

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 180, 0, 45)
MainFrame.Position = UDim2.new(0.5, -90, 0.1, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true -- Có thể di chuyển trên màn hình
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = MainFrame

local TextLabel = Instance.new("TextLabel")
TextLabel.Size = UDim2.new(1, 0, 1, 0)
TextLabel.BackgroundTransparency = 1
TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
TextLabel.Font = Enum.Font.GothamBold
TextLabel.TextSize = 14
TextLabel.Text = "Đang khởi tạo..."
TextLabel.Parent = MainFrame

-- HÀM SPAM ĐỔI SERVER KHI LỖI
local function ForceHop()
    TextLabel.Text = "Đang tìm SV mới..."
    TextLabel.TextColor3 = Color3.fromRGB(255, 165, 0) -- Màu cam khi đang spam
    
    -- Thử đổi server
    TeleportService:Teleport(game.PlaceId, LocalPlayer)
    
    -- Đợi 5 giây, nếu vẫn chưa biến mất khỏi server này thì tức là lỗi, sẽ chạy lại hàm này
    task.wait(5)
    ForceHop()
end

-- VÒNG LẶP ĐẾM NGƯỢC CHÍNH
task.spawn(function()
    while timeLeft > 0 do
        local hours = math.floor(timeLeft / 3600)
        local minutes = math.floor((timeLeft % 3600) / 60)
        local seconds = timeLeft % 60
        
        TextLabel.Text = string.format("Đổi SV: %02d:%02d:%02d", hours, minutes, seconds)
        task.wait(1)
        timeLeft = timeLeft - 1
    end
    
    -- Khi hết 1h30p, bắt đầu vòng lặp ForceHop
    ForceHop()
end)

-- XỬ LÝ LỖI TELEPORT (Khi Roblox hiện bảng báo lỗi)
TeleportService.TeleportInitFailed:Connect(function(player, result, errorMessage)
    if player == LocalPlayer then
        warn("Teleport thất bại: " .. tostring(errorMessage))
        task.wait(2)
        ForceHop()
    end
end)

-- Thông báo cho người dùng
game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "Server Hop";
    Text = "Hệ thống đã sẵn sàng. Đổi sau 1h30p.";
    Duration = 5;
})
